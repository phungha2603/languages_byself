DATABASE_URL="postgresql://app:app@localhost:5432/languages_byself?schema=public"
PORT=3000

# Optional — only required for live TTS/STT/Translation/AI-grading calls (see docs/ARCHITECTURE.md).
OPENAI_API_KEY=

# Required for Google Sign-In. Generate a long random string for JWT_SECRET
# (e.g. `openssl rand -hex 32`). GOOGLE_CLIENT_IDS is a comma-separated list
# of the OAuth 2.0 Client IDs from Google Cloud Console (Web/iOS/Android) —
# the backend accepts a Google ID token whose audience matches any of these.
JWT_SECRET=
GOOGLE_CLIENT_IDS=
