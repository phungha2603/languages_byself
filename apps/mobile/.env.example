# Google OAuth 2.0 Client IDs from Google Cloud Console (APIs & Services ->
# Credentials). These are public identifiers, safe to embed in client code —
# create one Client ID per platform you ship (Web is enough to test on
# `pnpm web`). The backend's GOOGLE_CLIENT_IDS (apps/api/.env) must include
# the same values so it accepts ID tokens issued for them.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
